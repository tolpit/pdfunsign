{
  "name": "pdfunsign",
  "version": "1.0.0",
  "description": "Client-side digital signature remover and PDF unlocker",
  "main": "app.js",
  "scripts": {
    "minify:js": "terser app.js -c -m -o app.min.js",
    "minify:css": "cleancss -o style.min.css style.css",
    "minify": "npm run minify:js && npm run minify:css",
    "build": "npm run minify",
    "watch": "node watch.js"
  },
  "keywords": [
    "pdf",
    "signature",
    "unlock",
    "client-side"
  ],
  "author": "PDFUnsign",
  "license": "ISC",
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "terser": "^5.39.0"
  }
}
